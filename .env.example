# Base URL of the backend API. Empty = /api/v1 on the same origin, for development with the mocks or the proxy below.
# Production (set as a GitHub Actions variable, not here): https://api.mscjerez.es/v1/rcc
VITE_API_URL=

# "true" serves the API from in-browser mocks (MSW) so the app works without a backend (development only).
VITE_API_MOCK=true

# Development with a real local backend: set VITE_API_MOCK=false and point this to it.
# Vite forwards /api/* to it, so http://localhost:5173/api/v1/... reaches http://localhost:8080/api/v1/...
API_PROXY_TARGET=http://localhost:8080

# Cloudflare Turnstile site key (free). The default is Cloudflare's public test key that always passes.
# Create a real one at https://dash.cloudflare.com/?to=/:account/turnstile and allow both
# rinconscout.mscjerez.es and localhost as hostnames.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

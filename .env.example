# Base URL of the backend API. Leave empty to use same-origin /api (recommended: serve API behind the same domain).
VITE_API_URL=

# "true" serves the API from in-browser mocks (MSW) so the app works without a backend.
VITE_API_MOCK=true

# Cloudflare Turnstile site key (free). The default is Cloudflare's public test key that always passes.
# Create a real one at https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
